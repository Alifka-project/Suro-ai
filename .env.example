# ── Contact form email delivery (Resend) ──────────────────────────────
# Without these, the form still validates and accepts submissions and
# logs each lead to the server console — nothing is silently lost.

# 1. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# 2. Where enquiries land
CONTACT_TO_EMAIL=

# 3. Sender. The domain must be verified in Resend before real sending.
#    For testing you can use: Suro AI <onboarding@resend.dev>
CONTACT_FROM_EMAIL="Suro AI <noreply@yourdomain.com>"
