# ── Contact form email delivery (Resend) ──────────────────────────────
# Optional notification on top of the dashboard: every submission is saved
# as a CRM lead regardless. Without these, the email step is simply skipped.

# 1. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# 2. Where enquiries land
CONTACT_TO_EMAIL=

# 3. Sender. The domain must be verified in Resend before real sending.
#    For testing you can use: SULOAI <onboarding@resend.dev>
CONTACT_FROM_EMAIL="SULOAI <noreply@yourdomain.com>"

# ── Admin dashboard (/admin) ──────────────────────────────────────────
# Postgres connection string — Neon or Vercel Postgres. Use the POOLED URL.
DATABASE_URL=

# Dashboard sign-in uses per-person admin accounts stored in the database,
# not a password in this file. Create one (you are prompted for the password):
#   npm run admin:user -- create <admin-id> "<Your name>"
# See README.md -> "Admin accounts" for list / set-password / deactivate.

# Signs session cookies. At least 32 characters — the app refuses to start
# with less. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Where this app is deployed (the domain /admin is served from), used for the
# "Open lead in dashboard" link in lead emails.
APP_URL=https://suloai.com

# ── Landing page ──────────────────────────────────────────────────────
# Public URL for canonical links, the sitemap, OpenGraph tags and structured
# data. Set it once a custom domain points at this Vercel project, e.g.
#   NEXT_PUBLIC_SITE_URL=https://suloai.com
# Leave empty to use Vercel's production domain automatically (localhost in
# development). Don't point it at a domain that still serves another site:
# search engines would treat this page as a copy of that one.
NEXT_PUBLIC_SITE_URL=

# Booking page (Calendly, Google Calendar appointment page, ...). When set,
# every "Book a call" button opens it. When empty, "Book a call" opens the
# contact form with "Video call" preselected.
NEXT_PUBLIC_BOOKING_URL=

# NEXT_PUBLIC_ values are fixed at build time: redeploy after changing them.
# The WhatsApp number is not an env variable: set CONTACT.whatsapp in
# src/lib/site.ts.

